try"/></mxCell><mxCell id="v33" value="loop" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#7c3aed;strokeColor=#7c3aed;fontColor=#ffffff;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="16" y="394" width="44" height="20" as="geometry"/></mxCell><mxCell id="v34" value="[pour chaque commande de la séance]" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=middle;fontSize=11;strokeColor=none;fillColor=none;fontStyle=2;fontColor=#5b21b6;" vertex="1" parent="1"><mxGeometry x="68" y="395" width="700" height="18" as="geometry"/></mxCell><mxCell id="v35" value="② ensuite, chacun de son côté : les autres contextes réagissent aux événements publiés" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=middle;fontSize=11.5;strokeColor=none;fillColor=none;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="20" y="605" width="900" height="18" as="geometry"/></mxCell><mxCell id="e36" value="PaiementARembourser(C-1, 20,50 €)" style="html=1;rounded=0;fontFamily=Helvetica;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;spacingBottom=1;endArrow=open;endFill=0;strokeColor=#1f2937;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="724.0" y="641" as="sourcePoint"/><mxPoint x="852.0" y="641" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e37" value="POST /v3/refunds {payment_id, montant}" style="html=1;rounded=0;fontFamily=Helvetica;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;spacingBottom=1;endArrow=block;endFill=1;strokeColor=#1f2937;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="852.0" y="666" as="sourcePoint"/><mxPoint x="980.0" y="666" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e38" value="refund.succeeded (plus tard)" style="html=1;rounded=0;fontFamily=Helvetica;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;spacingBottom=1;endArrow=open;endFill=0;strokeColor=#1f2937;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="980.0" y="691" as="sourcePoint"/><mxPoint x="852.0" y="691" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e39" value="PaiementARembourser → prévient le client (email, SMS)" style="html=1;rounded=0;fontFamily=Helvetica;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;spacingBottom=1;endArrow=open;endFill=0;strokeColor=#1f2937;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="724.0" y="716" as="sourcePoint"/><mxPoint x="1108.0" y="716" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e40" value="PaiementARembourser → retire ses billets de la liste des douchettes" style="html=1;rounded=0;fontFamily=Helvetica;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;spacingBottom=1;endArrow=open;endFill=0;strokeColor=#1f2937;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="724.0" y="741" as="sourcePoint"/><mxPoint x="1236.0" y="741" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e41" value="billet partenaire : pas de reversement, le partenaire rembourse (H1)" style="html=1;rounded=0;fontFamily=Helvetica;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;spacingBottom=1;endArrow=open;endFill=0;strokeColor=#1f2937;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="724.0" y="766" as="sourcePoint"/><mxPoint x="1364.0" y="766" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v42" value="&lt;b&gt;Ce que la Vente ne fait pas :&lt;/b&gt; elle ne connaît ni PayVia, ni les emails, ni les douchettes. Elle publie PaiementARembourser et CommandeExpiree ; ajouter une réaction = une nouvelle policy, sans toucher AnnulerSeanceService. Abonnements : un billet d'abonné d'une séance annulée n'est jamais un no-show (B8)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;shape=note;size=10;fillColor=#fef9c3;strokeColor=#ca8a04;fontSize=10.5;align=left;spacingLeft=6;spacingRight=4;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="162.0" y="797" width="690" height="54" as="geometry"/></mxCell><mxCell id="v43" value="&lt;b&gt;Et si PayVia confirme un paiement après l'annulation ?&lt;/b&gt; ConfirmerPaiementService : vendre lève VenteFermee → la commande passe A_REMBOURSER (testé : AnnulerSeanceTest)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;shape=note;size=10;fillColor=#fee2e2;strokeColor=#b91c1c;fontSize=10.5;align=left;spacingLeft=6;spacingRight=4;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="1078.0" y="797" width="470" height="54" as="geometry"/></mxCell><mxCell id="e44" value="" style="html=1;rounded=0;fontFamily=Helvetica;endArrow=none;dashed=1;strokeColor=#9ca3af;dashPattern=4 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="84.0" y="144" as="sourcePoint"/><mxPoint x="84.0" y="863" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e45" value="" style="html=1;rounded=0;fontFamily=Helvetica;endArrow=none;dashed=1;strokeColor=#9ca3af;dashPattern=4 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="212.0" y="144" as="sourcePoint"/><mxPoint x="212.0" y="863" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e46" value="" style="html=1;rounded=0;fontFamily=Helvetica;endArrow=none;dashed=1;strokeColor=#9ca3af;dashPattern=4 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340.0" y="144" as="sourcePoint"/><mxPoint x="340.0" y="863" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e47" value="" style="html=1;rounded=0;fontFamily=Helvetica;endArrow=none;dashed=1;strokeColor=#9ca3af;dashPattern=4 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="468.0" y="144" as="sourcePoint"/><mxPoint x="468.0" y="863" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e48" value="" style="html=1;rounded=0;fontFamily=Helvetica;endArrow=none;dashed=1;strokeColor=#9ca3af;dashPattern=4 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="596.0" y="144" as="sourcePoint"/><mxPoint x="596.0" y="863" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e49" value="" style="html=1;rounded=0;fontFamily=Helvetica;endArrow=none;dashed=1;strokeColor=#9ca3af;dashPattern=4 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="724.0" y="144" as="sourcePoint"/><mxPoint x="724.0" y="863" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e50" value="" style="html=1;rounded=0;fontFamily=Helvetica;endArrow=none;dashed=1;strokeColor=#9ca3af;dashPattern=4 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="852.0" y="144" as="sourcePoint"/><mxPoint x="852.0" y="863" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e51" value="" style="html=1;rounded=0;fontFamily=Helvetica;endArrow=none;dashed=1;strokeColor=#9ca3af;dashPattern=4 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="980.0" y="144" as="sourcePoint"/><mxPoint x="980.0" y="863" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e52" value="" style="html=1;rounded=0;fontFamily=Helvetica;endArrow=none;dashed=1;strokeColor=#9ca3af;dashPattern=4 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1108.0" y="144" as="sourcePoint"/><mxPoint x="1108.0" y="863" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e53" value="" style="html=1;rounded=0;fontFamily=Helvetica;endArrow=none;dashed=1;strokeColor=#9ca3af;dashPattern=4 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1236.0" y="144" as="sourcePoint"/><mxPoint x="1236.0" y="863" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e54" value="" style="html=1;rounded=0;fontFamily=Helvetica;endArrow=none;dashed=1;strokeColor=#9ca3af;dashPattern=4 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1364.0" y="144" as="sourcePoint"/><mxPoint x="1364.0" y="863" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v55" value="→ appel synchrone &amp;nbsp;&amp;nbsp; ⇢ re