ell id="v11" value="&lt;b&gt;Notification&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9.5px'&gt;«generic»&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#e0f2fe;strokeColor=#0369a1;fontSize=11;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1048.0" y="86" width="120" height="58" as="geometry"/></mxCell><mxCell id="v12" value="&lt;b&gt;Contrôle&lt;br&gt;d'accès&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#e0f2fe;strokeColor=#0369a1;fontSize=11;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1176.0" y="86" width="120" height="58" as="geometry"/></mxCell><mxCell id="v13" value="&lt;b&gt;Déclaration CNC&lt;br&gt;et reversements&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#e0f2fe;strokeColor=#0369a1;fontSize=11;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1304.0" y="86" width="120" height="58" as="geometry"/></mxCell><mxCell id="v14" value="① 18 h 00 · le programmateur annule la séance S42 (ou la déplace : même traitement)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=middle;fontSize=11.5;strokeColor=none;fillColor=none;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="20" y="166" width="700" height="18" as="geometry"/></mxCell><mxCell id="e15" value="SeanceAnnulee(S42)" style="html=1;rounded=0;fontFamily=Helvetica;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;spacingBottom=1;endArrow=open;endFill=0;strokeColor=#1f2937;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="84.0" y="200" as="sourcePoint"/><mxPoint x="212.0" y="200" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v16" value="simulé en HTTP : POST /programmation/seances/S42/annulation" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=middle;fontSize=9.5;strokeColor=none;fillColor=none;fontColor=#6b7280;fontStyle=2;" vertex="1" par