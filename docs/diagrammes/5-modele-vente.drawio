<mxfile host="app.diagrams.net" agent="generateur-ecrans-villeneuve"><diagram name="5-modele-vente" id="5-modele-vente"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="Quels agrégats protègent les règles de la vente ?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=middle;fontSize=20;strokeColor=none;fillColor=none;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1300" height="34" as="geometry"/></mxCell><mxCell id="v2" value="Modèle du domaine (section 8) : deux agrégats qui se référencent par identité, leurs value objects, le cycle de vie d'une commande et les événements publiés" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;fontColor=#6b7280;" vertex="1" parent="1"><mxGeometry x="30" y="48" width="1300" height="22" as="geometry"/></mxCell><mxCell id="v3" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#fffbeb;strokeColor=#d6b656;fontSize=11;dashed=1;dashPattern=8 4;arcSize=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="96" width="560" height="414" as="geometry"/></mxCell><mxCell id="v4" value="Agrégat Seance — le plan de salle d'une séance (contexte Vente)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;fontColor=#78350f;" vertex="1" parent="1"><mxGeometry x="42" y="100" width="400" height="20" as="geometry"/></mxCell><mxCell id="v5" value="&lt;p style='margin:4px 0 2px 0;text-align:center'&gt;&lt;span style='font-size:9.5px;color:#6b7280'&gt;«agrégat racine»&lt;/span&gt;&lt;br&gt;&lt;b style='font-size:12.5px'&gt;Seance&lt;/b&gt;&lt;/p&gt;&lt;hr size='1' style='border-color:#b7950b'&gt;&lt;p style='margin:2px 8px'&gt;id : SeanceId&lt;br&gt;debut : LocalDateTime&lt;br&gt;places : Map&amp;lt;PlaceId, EtatPlace&amp;gt;&lt;br&gt;version : long &lt;span style='color:#6b7280'&gt;(verrou optimiste)&lt;/span&gt;&lt;br&gt;annulee : boolean&lt;/p&gt;&lt;hr size='1'&gt;&lt;p style='margin:2px 8px'&gt;bloquer(places, commande, maintenant) : LocalDateTime&lt;br&gt;vendre(commande, places, maintenant)&lt;br&gt;libererBlocagesExpires(maintenant) : Set&amp;lt;CommandeId&amp;gt;&lt;br&gt;venteOuverteA(maintenant) : boolean&lt;br&gt;annuler() : boolean &lt;span style='color:#6b7280'&gt;(bonus)&lt;/span&gt;&lt;/p&gt;&lt;hr size='1'&gt;&lt;p style='margin:2px 8px;color:#7f1d1d'&gt;B1 · une place n'est vendue qu'une fois&lt;br&gt;tout ou rien : aucune place si une est prise&lt;br&gt;B2 · blocage de 10 min, libéré s'il expire&lt;br&gt;B4 · vente fermée 15 min après le début&lt;br&gt;B10 · séance annulée : plus rien ne se vend&lt;/p&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=10.5;rounded=0;spacing=0;fillColor=#ffffff;strokeColor=#b7950b;" vertex="1" parent="1"><mxGeometry x="48" y="150" width="300" height="344" as="geometry"/></mxCell><mxCell id="v6" value="&lt;p style='margin:4px 0 2px 0;text-align:center'&gt;&lt;span style='font-size:9.5px;color:#6b7280'&gt;«value object»&lt;/span&gt;&lt;br&gt;&lt;b style='font-size:12.5px'&gt;EtatPlace&lt;/b&gt;&lt;/p&gt;&lt;hr size='1' style='border-color:#b7950b'&gt;&lt;p style='margin:2px 8px'&gt;statut : StatutPlace&lt;br&gt;&amp;nbsp;&amp;nbsp;LIBRE | BLOQUEE | VENDUE&lt;br&gt;commande : CommandeId&lt;br&gt;bloqueeJusqua : LocalDateTime&lt;/p&gt;&lt;hr size='1'&gt;&lt;p style='margin:2px 8px'&gt;estLibreA(maintenant)&lt;br&gt;blocageExpireA(maintenant)&lt;br&gt;estBloqueePar(commande)&lt;/p&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=10.5;rounded=0;spacing=0;fillColor=#ffffff;strokeColor=#b7950b;" vertex="1" parent="1"><mxGeometry x="390" y="150" width="180" height="190" as="geometry"/></mxCell><mxCell id="v7" value="&lt;p style='margin:4px 0 2px 0;text-align:center'&gt;&lt;span style='font-size:9.5px;color:#6b7280'&gt;«value object»&lt;/span&gt;&lt;br&gt;&lt;b style='font-size:12.5px'&gt;PlaceId&lt;/b&gt;&lt;/p&gt;&lt;hr size='1' style='border-color:#b7950b'&gt;&lt;p style='margin:2px 8px'&gt;rang : char · numero : int&lt;br&gt;« G7 » · Comparable&lt;/p&gt;&lt;hr size='1'&gt;&lt;p style='margin:2px 8px'&gt;de(&quot;G7&quot;) : PlaceId&lt;/p&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=10.5;rounded=0;spacing=0;fillColor=#ffffff;strokeColor=#b7950b;" vertex="1" parent="1"><mxGeometry x="390" y="374" width="180" height="118" as="geometry"/></mxCell><mxCell id="e8" value="" style="html=1;rounded=0;fontFamily=Helvetica;endArrow=none;startArrow=diamondThin;startFill=1;startSize=14;strokeColor=#374151;fontSize=10;labelBackgroundColor=#fffbeb;exitX=1;exitY=0.18;exitDx=0;exitDy=0;entryX=0;entryY=0.33;entryDx=0;entryDy=0;" edge="1" parent="1" source="v5" target="v6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="clé" style="html=1;rounded=0;fontFamily=Helvetica;endArrow=open;endFill=0;strokeColor=#374151;fontSize=10;labelBackgroundColor=#fffbeb;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v5" target="v7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v10" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#fffbeb;strokeColor=#d6b656;fontSize=11;dashed=1;dashPattern=8 4;arcSize=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="650" y="96" width="620" height="414" as="geometry"/></mxCell><mxCell id="v11" value="Agrégat Commande — l'achat d'un client, du choix au paiement" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;fontStyle=1;fontColor=#78350f;" vertex="1" parent="1"><mxGeometry x="662" y="100" width="400" height="20" as="geometry"/></mxCell><mxCell id="v12" value="&lt;p style='margin:4px 0 2px 0;text-align:center'&gt;&lt;span style='font-size:9.5px;color:#6b7280'&gt;«agrégat racine»&lt;/span&gt;&lt;br&gt;&lt;b style='font-size:12.5px'&gt;Commande&lt;/b&gt;&lt;/p&gt;&lt;hr size='1' style='border-color:#b7950b'&gt;&lt;p style='margin:2px 8px'&gt;id : CommandeId&lt;br&gt;seance : SeanceId&lt;br&gt;billets : List&amp;lt;Billet&amp;gt; [1..10]&lt;br&gt;expireA : LocalDateTime&lt;br&gt;statut : StatutCommande&lt;br&gt;evenements : List&amp;lt;EvenementVente&amp;gt;&lt;/p&gt;&lt;hr size='1'&gt;&lt;p style='margin:2px 8px'&gt;creer(id, seance, billets, expireA) «static»&lt;br&gt;total() : Montant&lt;br&gt;payer(maintenant) · expirer(maintenant)&lt;br&gt;aRembourser(maintenant) &lt;span style='color:#6b7280'&gt;(bonus)&lt;/span&gt;&lt;br&gt;paiementDejaTraite() · retirerEvenements()&lt;/p&gt;&lt;hr size='1'&gt;&lt;p style='margin:2px 8px;color:#7f1d1d'&gt;B3 · 1 à 10 places, pas deux fois la même&lt;br&gt;B6 · total = somme des prix figés&lt;br&gt;jamais payée deux fois ; payée n'expire pas&lt;br&gt;B13 · payable après expiration ; sinon à rembourser&lt;/p&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=10.5;rounded=0;spacing=0;fillColor=#ffffff;strokeColor=#b7950b;" vertex="1" parent="1"><mxGeometry x="668" y="150" width="320" height="344" as="geometry"/></mxCell><mxCell id="v13" value="&lt;p style='margin:4px 0 2px 0;text-align:center'&gt;&lt;span style='font-size:9.5px;color:#6b7280'&gt;«value object»&lt;/span&gt;&lt;br&gt;&lt;b style='font-size:12.5px'&gt;Billet&lt;/b&gt;&lt;/p&gt;&lt;hr size='1' style='border-color:#b7950b'&gt;&lt;p style='margin:2px 8px'&gt;place : PlaceId&lt;br&gt;tarif : Tarif&lt;/p&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=10.5;rounded=0;spacing=0;fillColor=#ffffff;strokeColor=#b7950b;" vertex="1" parent="1"><mxGeometry x="1030" y="150" width="220" height="96" as="geometry"/></mxCell><mxCell id="v14" value="&lt;p style='margin:4px 0 2px 0;text-align:center'&gt;&lt;span style='font-size:9.5px;color:#6b7280'&gt;«value object»&lt;/span&gt;&lt;br&gt;&lt;b style='font-size:12.5px'&gt;Tarif&lt;/b&gt;&lt;/p&gt;&lt;hr size='1' style='border-color:#b7950b'&gt;&lt;p style='margin:2px 8px'&gt;categorie : Categorie&lt;br&gt;&amp;nbsp;&amp;nbsp;PLEIN | REDUIT | ENFANT | MATIN | ABONNE&lt;br&gt;prix : Montant &lt;b&gt;(figé, B6)&lt;/b&gt;&lt;/p&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=10.5;rounded=0;spacing=0;fillColor=#ffffff;strokeColor=#b7950b;" vertex="1" parent="1"><mxGeometry x="1030" y="270" width="220" height="96" as="geometry"/></mxCell><mxCell id="v15" value="&lt;p style='margin:4px 0 2px 0;text-align:center'&gt;&lt;span style='font-size:9.5px;color:#6b7280'&gt;«value object»&lt;/span&gt;&lt;br&gt;&lt;b style='font-size:12.5px'&gt;Montant&lt;/b&gt;&lt;/p&gt;&lt;hr size='1' style='border-color:#b7950b'&gt;&lt;p style='margin:2px 8px'&gt;centimes : long &lt;span style='color:#6b7280'&gt;(jamais négatif)&lt;/span&gt;&lt;/p&gt;&lt;hr size='1'&gt;&lt;p style='margin:2px 8px'&gt;plus(autre) · « 20,50 € »&lt;/p&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=10.5;rounded=0;spacing=0;fillColor=#ffffff;strokeColor=#b7950b;" vertex="1" parent="1"><mxGeometry x="1030" y="390" width="220" height="104" as="geometry"/></mxCell><mxCell id="e16" value="1..10" style="html=1;rounded=0;fontFamily=Helvetica;endArrow=none;startArrow=diamondThin;startFill=1;startSize=14;strokeColor=#374151;fontSize=10;labelBackgroundColor=#fffbeb;exitX=1;exitY=0.22;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v12" target="v13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="" style="html=1;rounded=0;fontFamily=Helvetica;endArrow=open;endFill=0;strokeColor=#374151;fontSize=10;labelBackgroundColor=#fffbeb;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v13" target="v14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" value="" style="html=1;rounded=0;fontFamily=Helvetica;endArrow=open;endFill=0;strokeColor=#374151;fontSize=10;labelBackgroundColor=#fffbeb;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v14" target="v15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e19" value="Commande.seance : SeanceId — référence par identité, jamais par l'objet" style="html=1;rounded=0;fontFamily=Helvetica;endArrow=open;endFill=0;dashed=1;strokeColor=#b45309;strokeWidth=1.5;fontSize=10;fontColor=#92400e;labelBackgroundColor=#ffffff;exitX=0.15;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v12" target="v5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="716" y="136"/><mxPoint x="198" y="136"/></Array></mxGeometry></mxCell><mxCell id="e20" value="" style="html=1;rounded=0;fontFamily=Helvetica;endArrow=open;endFill=0;dashed=1;strokeColor=#b45309;strokeWidth=1.5;fontSize=10;fontColor=#92400e;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="272" as="sourcePoint"/><mxPoint x="668" y="272" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v21" value="EtatPlace.commande&lt;br&gt;par identité" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=middle;fontSize=9.5;strokeColor=none;fillColor=none;fontColor=#92400e;align=center;" vertex="1" parent="1"><mxGeometry x="574" y="276" width="94" height="30" as="geometry"/></mxCell><mxCell id="v22" value="&lt;b&gt;ADR&lt;br&gt;0002&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px'&gt;payer modifie Seance ET Commande, même transaction&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#fee2e2;strokeColor=#b91c1c;fontSize=9.5;arcSize=10;" vertex="1" parent="1"><mxGeometry x="593" y="340" width="54" height="140" as="geometry"/></mxCell><mxCell id="v23" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="30" y="540" width="640" height="250" as="geometry"/></mxCell><mxCell id="v24" value="&lt;b&gt;Cycle de vie d'une Commande&lt;/b&gt; (StatutCommande) — chaque transition est une méthode de l'agrégat" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=middle;fontSize=11.5;strokeColor=none;fillColor=none;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="44" y="544" width="600" height="20" as="geometry"/></mxCell><mxCell id="v25" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;ellipse;fillColor=#111827;strokeColor=#111827;" vertex="1" parent="1"><mxGeometry x="48" y="656" width="16" height="16" as="geometry"/></mxCell><mxCell id="v26" value="EN_ATTENTE_PAIEMENT" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=40;fillColor=#fff2cc;strokeColor=#b7950b;fontSize=10.5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="96" y="644" width="170" height="40" as="geometry"/></mxCell><mxCell id="v27" value="PAYEE" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=40;fillColor=#fff2cc;strokeColor=#b7950b;fontSize=10.5;fontStyle=1;fillColor=#d5e8d4;strokeColor=#2e7d32;" vertex="1" parent="1"><mxGeometry x="352" y="578" width="120" height="40" as="geometry"/></mxCell><mxCell id="v28" value="EXPIREE" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=40;fillColor=#fff2cc;strokeColor=#b7950b;fontSize=10.5;fontStyle=1;fillColor=#f5f5f5;strokeColor=#6b7280;" vertex="1" parent="1"><mxGeometry x="352" y="730" width="120" height="40" as="geometry"/></mxCell><mxCell id="v29" value="A_REMBOURSER" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=40;fillColor=#fff2cc;strokeColor=#b7950b;fontSize=10.5;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="530" y="644" width="128" height="40" as="geometry"/></mxCell><mxCell id="e30" value="creer" style="html=1;rounded=0;fontFamily=Helvetica;endArrow=block;endFill=1;strokeColor=#374151;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v25" target="v26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e31" value="payer" style="html=1;rounded=0;fontFamily=Helvetica;endArrow=block;endFill=1;strokeColor=#374151;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v26" target="v27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e32" value="expirer (B2)" style="html=1;rounded=0;fontFamily=Helvetica;endArrow=block;endFill=1;strokeColor=#374151;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v26" target="v28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e33" value="payer : tardif, places&lt;br&gt;encore libres (B13)" style="html=1;rounded=0;fontFamily=Helvetica;endArrow=block;endFill=1;strokeColor=#374151;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.2;exitY=0;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="v28" target="v27"><mxGeometry x="-0.55" relative