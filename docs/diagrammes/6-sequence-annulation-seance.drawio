e (idempotent)" style="html=1;rounded=0;fontFamily=Helvetica;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;spacingBottom=1;endArrow=open;endFill=0;dashed=1;strokeColor=#4b5563;fontColor=#374151;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="468.0" y="342" as="sourcePoint"/><mxPoint x="340.0" y="342" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e23" value="Seances.enregistrer(seance) · Commandes.deLaSeance(S42)" style="html=1;rounded=0;fontFamily=Helvetica;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;spacingBottom=1;endArrow=block;endFill=1;strokeColor=#1f2937;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340.0" y="367" as="sourcePoint"/><mxPoint x="724.0" y="367" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e24" value="aRembourser(18:00) → enregistre PaiementARembourser" style="html=1;rounded=0;fontFamily=Helvetica;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;spacingBottom=1;endArrow=block;endFill=1;strokeColor=#1f2937;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340.0" y="450" as="sourcePoint"/><mxPoint x="596.0" y="450" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e25" value="expirer(18:00) → enregistre CommandeExpiree" style="html=1;rounded=0;fontFamily=Helvetica;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;spacingBottom=1;endArrow=block;endFill=1;strokeColor=#1f2937;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340.0" y="501" as="sourcePoint"/><mxPoint x="596.0" y="501" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e26" value="Commandes.enregistrer(commande) · PublicateurEvenements.publier(événement)" style="html=1;rounded=0;fontFamily=Helvetica;fontSize=11;verticalAlign=bottom;labelBackgroundColor=#ffffff;spacingBottom=1;endArrow=block;endFill=1;strokeColor=#1f2937;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340.0" y="560" as="sourceP