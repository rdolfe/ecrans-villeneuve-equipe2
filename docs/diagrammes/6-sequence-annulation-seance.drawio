<mxfile host="app.diagrams.net" agent="generateur-ecrans-villeneuve"><diagram name="6-sequence-annulation-seance" id="6-sequence-annulation-seance"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="Que se passe-t-il quand le cinéma annule une séance déjà vendue ?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=middle;fontSize=20;strokeColor=none;fillColor=none;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1460" height="34" as="geometry"/></mxCell><mxCell id="v2" value="Séquence facultative (section 7) : un scénario asynchrone entre contextes (B10). On voit quel contexte publie quel événement, et qui y réagit. La partie Vente est codée (bonus 9.4)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;align=left;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;fontColor=#6b7280;" vertex="1" parent="1"><mxGeometry x="30" y="48" width="1460" height="22" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;Programmation&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9.5px'&gt;«contexte»&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#e0f2fe;strokeColor=#0369a1;fontSize=11;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="24.0" y="86" width="120" height="58" as="geometry"/></mxCell><mxCell id="v4" value="&lt;b&gt;AnnulationSeance&lt;br&gt;Controller&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="152.0" y="86" width="120" height="58" as="geometry"/></mxCell><mxCell id="v5" value="&lt;b&gt;AnnulerSeance&lt;br&gt;Service&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1